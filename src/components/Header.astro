---
import { ROUTES, SOCIAL } from '../consts';
import { Icon } from 'astro-icon/components';
---
<div class="header-container" transition:persist>
    <div class="my-8 sm:my-12 site-header">
        <img class="logo" src="/logo.png" alt="Myshkin Art (Logo)">
    </div>
    <nav class="flex flex-wrap justify-center gap-x-4 gap-y-2 md:gap-6 nav-container">
      {ROUTES.map((route) => <a class="nav-link" href={route.href}>{route.labelImage ? <img class="routeLabelImage" src={route.labelImage} /> : route.label}</a>)}
      <div class="flex gap-4 socials-container">
      {
        SOCIAL.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="me noopener noreferrer"
            class="socials nav-link"
          >
            <Icon
              name={social.icon}
              aria-label={social.label}
              class="h-5 w-5"
              fill="currentColor"
              width="24"
              height="24"
            />
          </a>
        ))
      }
    </div>
    </nav>
    
    
</div>

<style>
  @reference "../styles/global.css";
  a {
    @apply text-muted transition-colors hover:text-accent active:text-accent;
  }
</style>